# Comma-separated URL prefix=directory pairs. Each directory must already exist.
# FILE_DIRS=/downloads/=/var/www/html,/media/=/var/media
FILE_DIRS=

# Optional static image directories, in the same prefix=path form.
# IMAGE_DIRS=/images/=/var/opds/images
IMAGE_DIRS=

# Static OPDS 1.2 catalogs, in the same prefix=path form. Files must already exist.
# The suffix selects the Content-Type:
#   .nav.xml    application/atom+xml;profile=opds-catalog;kind=navigation
#   .acq.xml    application/atom+xml;profile=opds-catalog;kind=acquisition
#   .entry.xml  application/atom+xml;type=entry;profile=opds-catalog
#   .osd.xml    application/opensearchdescription+xml
# A directory URL serves index.nav.xml, or index.acq.xml when that file is the catalog root.
# Search results, shelf, subscriptions, and authentication are not served.
# OPDS_DIRS=/opds/=/var/opds
OPDS_DIRS=

# Redis Stack connection used by search, browse, and the catalog scripts.
# The password may be empty. REDIS_POOL_SIZE is per worker.
# REDIS_KEEPALIVE is the idle timeout in seconds.
# REDIS_DB defaults to 0. REDIS_INDEX defaults to publications.
# REDIS_CATALOG defaults to catalog. Pool size and keepalive default to 8 and 60.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_POOL_SIZE=8
# REDIS_KEEPALIVE=60
# REDIS_INDEX=publications
# REDIS_CATALOG=catalog

# Static feed max-age in seconds. Defaults to 300 when unset.
# RESPONSE_TTL=300
